{
 "title": "ジャンル別に探す",
 "genres": [
  {
   "id": "isekai",
   "name": "異世界・ファンタジー",
   "description": "異世界に転生・転移する物語や、剣と魔法の世界が舞台の作品です。冒険や成り上がり、のんびりした暮らし、貴族や聖女が活躍する物語まで、幅広い作品を集めました。"
  },
  {
   "id": "battle",
   "name": "バトル・アクション",
   "description": "能力を使った戦いや、格闘、剣と魔法のバトルなど、迫力のある戦闘シーンが魅力の作品です。熱血もの、ダークなもの、笑えるバトルまで集めました。"
  },
  {
   "id": "love",
   "name": "恋愛・ラブコメ",
   "description": "恋を描いた物語や、ドキドキのラブコメ作品です。幼なじみ、学園、大人の恋、ファンタジーの世界の恋愛まで、さまざまな恋のかたちを集めました。"
  },
  {
   "id": "comedy",
   "name": "コメディ・日常",
   "description": "笑えるギャグ作品や、ゆるい毎日を描いた日常系の作品です。にぎやかな学園生活や、のんびりした暮らしを描いた作品を集めました。"
  },
  {
   "id": "mystery",
   "name": "ミステリー・サスペンス",
   "description": "事件の謎を追う推理ものや、先の読めないサスペンスの作品です。頭脳戦、デスゲーム、ホラーミステリーまで、続きが気になる作品を集めました。"
  },
  {
   "id": "horror",
   "name": "ホラー",
   "description": "幽霊や妖怪、怪異が登場するこわい物語の作品です。ぞくっとする怖さのものから、笑えるホラーコメディまで集めました。"
  },
  {
   "id": "sports",
   "name": "スポーツ",
   "description": "野球、サッカー、バスケ、バレーなど、スポーツに打ち込む人たちを描いた作品です。試合の熱さと、仲間とのきずなが魅力の作品を集めました。"
  },
  {
   "id": "youth",
   "name": "青春・学園",
   "description": "学校生活や、部活、友情、成長を描いた作品です。大学生活や、バンド、芸術に打ち込む物語まで、青春のさまざまな姿を集めました。"
  },
  {
   "id": "sf",
   "name": "SF",
   "description": "未来の世界や、科学、宇宙、仮想世界などが登場する作品です。サイバーパンクから、終末もの、ゲームの世界まで集めました。"
  },
  {
   "id": "tears",
   "name": "泣ける・感動",
   "description": "運営者が泣けると思った作品を、ジャンルとして集めました。友情や別れ、成長が描かれた作品です。"
  }
 ],
